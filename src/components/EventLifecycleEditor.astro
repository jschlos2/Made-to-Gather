---
import type { InvitationEvent } from '../data/events';
const { event } = Astro.props as { event: InvitationEvent };
---
<section class="settings-editor" data-lifecycle-editor data-event={event.slug}>
  <div class="host-section-title"><h2>Event settings</h2></div>
  <p data-editor-status role="status" aria-live="polite">Loading current settings…</p>
  <form data-editor-form hidden>
    <div class="setting-row setting-row--lifecycle"><div><label for="event-status">Event status</label><select id="event-status" name="status"><option value="draft">Draft</option><option value="rsvp_open">RSVP open</option><option value="rsvp_closed">RSVP closed</option><option value="event_day">Event day</option><option value="photos_open">Photos open</option><option value="archived">Archived</option></select><label class="setting-check"><input type="checkbox" name="rsvpOpen"/> Accept new RSVPs</label><label class="setting-check"><input type="checkbox" name="photoUploadsOpen" disabled={!event.photos.uploadsEnabled}/> Accept guest photo uploads</label></div><button class="host-button" type="submit">Save status</button></div>
    <div class="setting-row"><div><span>Event date</span><strong>{event.date.weekday}, {event.date.monthDay}, {event.date.year}</strong></div><span class="setting-source">Invitation configuration</span></div>
    <div class="setting-row"><div><span>Time zone</span><strong>{event.calendar.timeZone}</strong></div><span class="setting-source">Invitation configuration</span></div>
    <div class="setting-row"><div><span>Invitation configuration</span><strong>Artwork, copy, RSVP questions</strong></div><a class="host-button host-button--outline" href={`/host/events/${event.slug}/preview/`}>Preview</a></div>
    <div class="setting-row"><div><span>Guest photo uploads</span><strong>{event.photos.uploadsEnabled ? 'Available — every upload needs approval' : 'Disabled for this event'}</strong></div><a class="host-button host-button--outline" href={`/host/events/${event.slug}/photos/`}>Photos</a></div>
    <div class="setting-row"><div><span>Responses export</span><strong>CSV of all RSVPs for this event</strong></div><a class="host-button host-button--outline" href={`/host/api/rsvps?event=${event.slug}&attendance=all&sort=newest&format=csv`}>Export CSV</a></div>
  </form>
</section>
<script>
  const root=document.querySelector<HTMLElement>('[data-lifecycle-editor]');const form=root?.querySelector<HTMLFormElement>('[data-editor-form]');const message=root?.querySelector<HTMLElement>('[data-editor-status]');const slug=root?.dataset.event||'';const statusSelect=form?.elements.namedItem('status') as HTMLSelectElement|null;const rsvp=form?.elements.namedItem('rsvpOpen') as HTMLInputElement|null;const photos=form?.elements.namedItem('photoUploadsOpen') as HTMLInputElement|null;let initialRsvp=false;
  const defaults:Record<string,{rsvp?:boolean;photos?:boolean}>={draft:{rsvp:false,photos:false},rsvp_open:{rsvp:true},rsvp_closed:{rsvp:false},event_day:{},photos_open:{rsvp:false,photos:true},archived:{rsvp:false,photos:false}};
  async function load(){const response=await fetch(`/host/api/events?event=${slug}`);const data=await response.json().catch(()=>null);if(!response.ok||!data?.events?.[0]){if(message)message.textContent=data?.message||'Settings could not be loaded.';return}const current=data.events[0];if(statusSelect)statusSelect.value=current.status;if(rsvp)rsvp.checked=current.rsvpOpen;if(photos)photos.checked=current.photoUploadsOpen;initialRsvp=current.rsvpOpen;if(form)form.hidden=false;if(message)message.textContent=`Current settings loaded from ${current.source}.`}
  statusSelect?.addEventListener('change',()=>{const next=defaults[statusSelect.value];if(rsvp&&typeof next.rsvp==='boolean')rsvp.checked=next.rsvp;if(photos&&!photos.disabled&&typeof next.photos==='boolean')photos.checked=next.photos});
  form?.addEventListener('submit',async(event)=>{event.preventDefault();if(!statusSelect||!rsvp||!photos)return;const closing=initialRsvp&&!rsvp.checked;const archiving=statusSelect.value==='archived';if(closing&&!confirm('Close RSVPs for this event? Guests will no longer be able to submit the form.'))return;if(archiving&&!confirm('Archive this event as a family keepsake? RSVP and photo uploads will be closed.'))return;const button=form.querySelector<HTMLButtonElement>('button[type=submit]');if(button)button.disabled=true;if(message)message.textContent='Saving…';const response=await fetch('/host/api/events',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({eventSlug:slug,status:statusSelect.value,rsvpOpen:rsvp.checked,photoUploadsOpen:photos.checked,confirmClose:closing,confirmArchive:archiving})});const data=await response.json().catch(()=>null);if(response.ok&&data?.ok){initialRsvp=data.event.rsvpOpen;rsvp.checked=data.event.rsvpOpen;photos.checked=data.event.photoUploadsOpen;if(message)message.textContent='Lifecycle settings saved.'}else if(message)message.textContent=data?.message||'Settings could not be saved.';if(button)button.disabled=false});void load();
</script>
<style>
  .settings-editor{padding-top:.5rem}.settings-editor>p{margin:0 0 1rem}.settings-editor form{display:block}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:5.2rem;padding:1rem 0;border-bottom:1px solid var(--host-rule-soft)}.setting-row span,.setting-row label:not(.setting-check){display:block;margin-bottom:.3rem;font-size:.66rem;letter-spacing:.17em;text-transform:uppercase}.setting-row strong{font-size:1.1rem;font-weight:400}.setting-source{max-width:12rem;text-align:right}.setting-row--lifecycle{align-items:end}.setting-row--lifecycle>div{display:grid;grid-template-columns:minmax(12rem,1fr) auto auto;align-items:center;gap:.65rem 1.25rem}.setting-row select{min-height:44px;padding:.5rem;border:1px solid var(--host-rule);background:transparent;color:var(--host-ink)}.setting-check{display:flex;align-items:center;gap:.45rem}.setting-check input{width:1.2rem;height:1.2rem}@media(max-width:48rem){.setting-row{align-items:flex-start;flex-direction:column}.setting-row--lifecycle>div{grid-template-columns:1fr}.setting-source{text-align:left}}
</style>
