---
import type { InvitationEvent } from '../data/events';
const { event } = Astro.props as { event: InvitationEvent };
---
{(event.photos.uploadsEnabled || event.photos.galleryEnabled) && (
  <nav class="photo-actions" aria-label="Event photos" data-photo-actions data-event={event.slug}>
    {event.photos.uploadsEnabled && <a href={`/events/${event.slug}/photos/upload`} data-upload-link hidden>Add your photos</a>}
    {event.photos.galleryEnabled && <a href={`/events/${event.slug}/photos`} data-gallery-link hidden>View event photos</a>}
    {event.photos.galleryEnabled && <p class="photo-actions__empty" data-gallery-empty hidden>No approved photos have been added yet.</p>}
  </nav>
)}
<script>
  for (const nav of document.querySelectorAll<HTMLElement>('[data-photo-actions]')) {
    const link = nav.querySelector<HTMLAnchorElement>('[data-gallery-link]');
    const upload = nav.querySelector<HTMLAnchorElement>('[data-upload-link]');
    const empty = nav.querySelector<HTMLElement>('[data-gallery-empty]');
    const statusRequest = fetch(`/api/events/status/${nav.dataset.event}`, { headers: { Accept: 'application/json' } }).then((response) => response.ok ? response.json() : null);
    const galleryRequest = link ? fetch(`/api/photos/gallery/${nav.dataset.event}`, { headers: { Accept: 'application/json' } }).then((response) => response.ok ? response.json() : null) : Promise.resolve(null);
    Promise.all([statusRequest, galleryRequest]).then(([statusResult, galleryResult]) => {
      if (upload && statusResult?.lifecycle?.photoUploadsOpen) upload.hidden = false;
      if (link && galleryResult?.photos?.length) link.hidden = false;
      if (empty && statusResult?.lifecycle?.status === 'archived' && !galleryResult?.photos?.length) empty.hidden = false;
    }).catch(() => {});
  }
</script>
<style>
  .photo-actions { display:flex; flex-wrap:wrap; justify-content:center; gap:.75rem; padding:2rem 1.25rem; border-top:var(--border); }
  .photo-actions a { display:inline-flex; min-height:44px; align-items:center; padding:.65rem 1rem; border:1px solid currentColor; color:var(--color-ink); font-family:var(--font-label); font-weight:700; letter-spacing:.04em; text-decoration:none; text-transform:uppercase; }
  .photo-actions a:hover { background:var(--color-ink); color:var(--color-white); }
  .photo-actions__empty { width:100%; margin:0; text-align:center; font-style:italic; }
</style>
