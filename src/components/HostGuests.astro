---
import type { InvitationEvent } from '../data/events';
const { event } = Astro.props as { event: InvitationEvent };
---
<section class="host-guests" data-host-guests data-event={event.slug}>
  <div class="guest-filters" role="group" aria-label="Filter guests">
    <button type="button" data-filter="all" aria-pressed="true">All Guests <span data-count="all">—</span></button>
    <button type="button" data-filter="attending" aria-pressed="false">Attending <span data-count="attending">—</span></button>
    <button type="button" data-filter="declines" aria-pressed="false">Unable to Attend <span data-count="declines">—</span></button>
    <button type="button" data-filter="dietary" aria-pressed="false">Has Dietary <span data-count="dietary">—</span></button>
    <button type="button" data-filter="message" aria-pressed="false">Has Message <span data-count="message">—</span></button>
    <span class="guest-response-count" data-response-count>— responses</span>
    <label class="guest-sort"><span class="visually-hidden">Sort guests</span><select data-sort><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="name">Guest name</option></select></label>
  </div>
  <p class="guest-status" data-guest-status role="status" aria-live="polite">Loading guests…</p>
  <div class="guest-column-head" aria-hidden="true"><span>Guest</span><span>Response</span><span>Party</span><span>Mobile</span><span></span></div>
  <div class="guest-list" data-guest-list></div>
</section>
<script>
  import { copyMessage } from '../scripts/copy-message.js';
  const root=document.querySelector<HTMLElement>('[data-host-guests]');const slug=root?.dataset.event||'';const list=root?.querySelector<HTMLElement>('[data-guest-list]');const status=root?.querySelector<HTMLElement>('[data-guest-status]');const sort=root?.querySelector<HTMLSelectElement>('[data-sort]');let filter=new URL(location.href).searchParams.get('filter')||'all';let rows:any[]=[];
  const say=(text:string)=>{if(status)status.textContent=text};const hasText=(value:unknown)=>Boolean(String(value||'').trim());
  function applyFilter(){const filtered=rows.filter(row=>filter==='all'||filter===row.attendance_status||(filter==='dietary'&&hasText(row.dietary_restrictions))||(filter==='message'&&hasText(row.message)));render(filtered);root?.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.filter===filter)))}
  function labeled(label:string,value:HTMLElement|string){const div=document.createElement('div');const small=document.createElement('span');small.className='guest-detail-label';small.textContent=label;div.append(small,typeof value==='string'?document.createTextNode(value||'—'):value);return div}
  function guestRow(rsvp:any){const details=document.createElement('details');details.className='guest-row';const summary=document.createElement('summary');const guest=document.createElement('span');guest.className='guest-name';guest.textContent=rsvp.guest_name;const flags=document.createElement('small');flags.textContent=[hasText(rsvp.dietary_restrictions)?'Dietary':'',hasText(rsvp.message)?'Message':''].filter(Boolean).join(' · ');guest.append(flags);const response=document.createElement('span');response.className=`guest-response guest-response--${rsvp.attendance_status}`;response.textContent=rsvp.attendance_status==='attending'?'Attending':'Unable';const party=document.createElement('span');party.textContent=`${Number(rsvp.adults||0)+Number(rsvp.children||0)} ${Number(rsvp.adults||0)+Number(rsvp.children||0)===1?'person':'people'}`;const mobile=document.createElement('span');mobile.className='guest-mobile';const number=document.createElement('span');number.textContent=rsvp.masked_mobile_number||'—';const reveal=document.createElement('button');reveal.type='button';reveal.textContent='Reveal';reveal.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();const showing=number.textContent===rsvp.mobile_number;number.textContent=showing?rsvp.masked_mobile_number:rsvp.mobile_number;reveal.textContent=showing?'Reveal':'Hide'});mobile.append(number,document.createTextNode(' '),reveal);const actions=document.createElement('span');actions.className='guest-row-actions';if(rsvp.sms_uri){const text=document.createElement('a');text.href=rsvp.sms_uri;text.textContent='Text';text.addEventListener('click',event=>event.stopPropagation());actions.append(text)}const chevron=document.createElement('span');chevron.className='guest-chevron';chevron.setAttribute('aria-hidden','true');chevron.textContent='▼';actions.append(chevron);summary.append(guest,response,party,mobile,actions);
    const expanded=document.createElement('div');expanded.className='guest-expanded';expanded.append(labeled('Party breakdown',`${rsvp.adults} adult${rsvp.adults===1?'':'s'}, ${rsvp.children} child${rsvp.children===1?'':'ren'}`),labeled('Dietary restrictions',rsvp.dietary_restrictions||'None noted.'),labeled('Submitted',new Intl.DateTimeFormat(undefined,{dateStyle:'medium',timeStyle:'short'}).format(new Date(rsvp.submitted_at))),labeled('Message',rsvp.message||'No message left.'));
    const expandedActions=document.createElement('div');expandedActions.className='guest-expanded-actions';const copy=document.createElement('button');copy.type='button';copy.className='host-button host-button--outline';copy.textContent='Copy message';const feedback=document.createElement('span');feedback.setAttribute('role','status');copy.addEventListener('click',async()=>{feedback.textContent=await copyMessage(String(rsvp.text_message||rsvp.message||''))?'Message copied.':'Copy is unavailable.'});const del=document.createElement('button');del.type='button';del.className='host-button host-button--danger';del.textContent='Delete RSVP';del.addEventListener('click',async()=>{if(!confirm(`Permanently delete the RSVP for ${rsvp.guest_name}? This cannot be undone.`))return;del.disabled=true;const response=await fetch(`/host/api/rsvps/${rsvp.id}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({confirm:'DELETE'})});if(response.ok)await load();else{feedback.textContent='The RSVP could not be deleted.';del.disabled=false}});expandedActions.append(copy,del,feedback);expanded.append(expandedActions);details.append(summary,expanded);return details}
  function render(filtered:any[]){list?.replaceChildren();filtered.forEach(rsvp=>list?.append(guestRow(rsvp)));say(filtered.length?`${filtered.length} response${filtered.length===1?'':'s'} shown.`:'No guests match this filter.')}
  function updateCounts(){const counts={all:rows.length,attending:rows.filter(r=>r.attendance_status==='attending').length,declines:rows.filter(r=>r.attendance_status==='declines').length,dietary:rows.filter(r=>hasText(r.dietary_restrictions)).length,message:rows.filter(r=>hasText(r.message)).length};for(const [name,value] of Object.entries(counts)){const target=root?.querySelector<HTMLElement>(`[data-count="${name}"]`);if(target)target.textContent=String(value)}const total=root?.querySelector<HTMLElement>('[data-response-count]');if(total)total.textContent=`${rows.length} responses`}
  async function load(){say('Loading guests…');const response=await fetch(`/host/api/rsvps?event=${slug}&attendance=all&sort=${sort?.value||'newest'}`);const data=await response.json().catch(()=>null);if(!response.ok||!data?.ok){say(data?.message||'Guests could not be loaded.');return}rows=data.rsvps||[];updateCounts();applyFilter()}
  root?.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{filter=button.dataset.filter||'all';applyFilter()}));sort?.addEventListener('change',load);void load();
</script>
<style>
  .host-guests{padding-top:1.5rem}.guest-filters{display:flex;align-items:center;gap:.5rem;padding-bottom:1.25rem;border-bottom:1px solid var(--host-ink);overflow-x:auto}.guest-filters button,.guest-sort select{min-height:44px;padding:.65rem 1rem;border:1px solid var(--host-rule);background:transparent;color:var(--host-ink);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}.guest-filters button[aria-pressed='true']{border-color:var(--host-ink);background:var(--host-ink);color:white}.guest-response-count{margin-left:auto;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}.guest-status{margin:.8rem 0}.guest-column-head,.guest-row summary{display:grid;grid-template-columns:2fr 1fr .8fr 1.25fr .8fr;align-items:center;gap:1rem}.guest-column-head{padding:.65rem .5rem;font-size:.64rem;letter-spacing:.18em;text-transform:uppercase}.guest-row{border-bottom:1px solid var(--host-rule-soft)}.guest-row summary{min-height:4.5rem;padding:.75rem .5rem;cursor:pointer;list-style:none}.guest-row summary::-webkit-details-marker{display:none}.guest-name{font-size:1.05rem}.guest-name small{display:block;margin-top:.2rem;color:var(--host-green);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase}.guest-response{justify-self:start;padding:.25rem .45rem;background:var(--host-green);color:white;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}.guest-response--declines{background:transparent;color:var(--host-coral);border:1px solid currentColor}.guest-mobile button{padding:0;border:0;background:none;color:inherit;font-size:.65rem;text-transform:uppercase}.guest-row-actions{display:flex;align-items:center;justify-content:flex-end;gap:.75rem}.guest-row-actions a{min-width:58px;padding:.55rem;border:1px solid var(--host-rule);font-size:.68rem;letter-spacing:.12em;text-align:center;text-decoration:none;text-transform:uppercase}.guest-row[open] .guest-chevron{transform:rotate(180deg)}.guest-expanded{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;padding:1.25rem .5rem 1.5rem;background:rgba(255,255,255,.42)}.guest-expanded>div:nth-child(4){grid-column:1/3}.guest-detail-label{display:block;margin-bottom:.35rem;font-size:.62rem;letter-spacing:.17em;text-transform:uppercase}.guest-expanded-actions{grid-column:3;display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:end;gap:.5rem}.guest-expanded-actions [role=status]{width:100%;font-size:.75rem;text-align:right}@media(max-width:48rem){.guest-column-head{display:none}.guest-row summary{grid-template-columns:1.5fr auto auto}.guest-row summary>span:nth-child(3),.guest-mobile{grid-row:2}.guest-name{grid-column:1/3}.guest-row-actions{grid-column:3;grid-row:1/3}.guest-expanded{grid-template-columns:1fr 1fr}.guest-expanded>div:nth-child(4),.guest-expanded-actions{grid-column:1/-1}.guest-expanded-actions{justify-content:flex-start}}@media(max-width:28rem){.guest-row summary{grid-template-columns:1fr auto}.guest-name{grid-column:1}.guest-response{grid-column:1}.guest-row-actions{grid-column:2;grid-row:1/4}.guest-mobile{grid-column:1}.guest-expanded{grid-template-columns:1fr}}
</style>
