---
import { events } from '../data/events';
---
<section class="host-photos" id="photo-moderation" data-host-photos>
  <header><div><p class="host-kicker">Private moderation</p><h2>Guest photos</h2></div><button type="button" data-bulk disabled>Approve selected</button></header>
  <div class="host-photo-controls"><label>Event<select data-photo-event><option value="all">All events</option>{events.map(event=><option value={event.slug}>{event.title}</option>)}</select></label><label>Status<select data-photo-status><option value="pending">Pending review</option><option value="approved">Approved</option><option value="removed">Removed</option><option value="all">All photos</option></select></label></div>
  <p data-photo-message role="status" aria-live="polite">Loading photos…</p><div class="host-photo-grid" data-photo-grid></div>
</section>
<script>
  const root=document.querySelector<HTMLElement>('[data-host-photos]');const grid=root?.querySelector<HTMLElement>('[data-photo-grid]');const message=root?.querySelector<HTMLElement>('[data-photo-message]');const eventSelect=root?.querySelector<HTMLSelectElement>('[data-photo-event]');const statusSelect=root?.querySelector<HTMLSelectElement>('[data-photo-status]');const bulk=root?.querySelector<HTMLButtonElement>('[data-bulk]');
  const say=(text:string)=>{if(message)message.textContent=text}; const selected=()=>Array.from(root?.querySelectorAll<HTMLInputElement>('input[data-photo-select]:checked')||[]).map(i=>i.value);
  async function action(id:string,action:string){const response=await fetch(`/host/api/photos/${id}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({action})});if(!response.ok)throw new Error('The photo could not be updated.');await load()}
  async function load(){say('Loading photos…');const response=await fetch(`/host/api/photos?event=${eventSelect?.value||'all'}&status=${statusSelect?.value||'pending'}`);const data=await response.json().catch(()=>null);if(!response.ok||!data?.ok){say(data?.message||'Photos could not be loaded.');return}grid?.replaceChildren();for(const photo of data.photos){const card=document.createElement('article');card.className='host-photo-card';const img=document.createElement('img');img.src=photo.previewUrl;img.alt='Guest-submitted event photo';img.loading='lazy';const meta=document.createElement('p');meta.textContent=`${photo.event_slug} · ${photo.original_filename||'Unnamed photo'} · ${new Intl.DateTimeFormat(undefined,{dateStyle:'medium',timeStyle:'short'}).format(new Date(photo.uploaded_at))}`;const state=document.createElement('strong');state.textContent=photo.moderation_status;const actions=document.createElement('div');actions.className='host-photo-actions';if(photo.moderation_status==='pending'){const label=document.createElement('label');const check=document.createElement('input');check.type='checkbox';check.value=photo.id;check.dataset.photoSelect='';check.addEventListener('change',()=>{if(bulk)bulk.disabled=!selected().length});label.append(check,document.createTextNode(' Select'));actions.append(label)}for(const [name,label] of photo.moderation_status==='pending'?[['approve','Approve'],['remove','Remove']]:photo.moderation_status==='approved'?[['remove','Remove']]:[['restore','Restore']]){const button=document.createElement('button');button.type='button';button.textContent=label;button.addEventListener('click',()=>action(photo.id,name).catch(e=>say(e.message)));actions.append(button)}if(photo.moderation_status==='removed'){const del=document.createElement('button');del.type='button';del.textContent='Delete permanently';del.addEventListener('click',async()=>{if(!confirm('Permanently delete this photo? This cannot be undone.'))return;const response=await fetch(`/host/api/photos/${photo.id}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({confirm:'DELETE'})});if(response.ok)await load();else say('The photo could not be deleted.')});actions.append(del)}card.append(img,state,meta,actions);grid?.append(card)}say(data.photos.length?`${data.photos.length} photo${data.photos.length===1?'':'s'} shown.`:'No photos match this filter.');if(bulk)bulk.disabled=true}
  const initialPhotoEvent=new URL(location.href).searchParams.get('photoEvent');if(eventSelect&&initialPhotoEvent&&Array.from(eventSelect.options).some(option=>option.value===initialPhotoEvent))eventSelect.value=initialPhotoEvent;
  eventSelect?.addEventListener('change',load);statusSelect?.addEventListener('change',load);bulk?.addEventListener('click',async()=>{const ids=selected();if(!ids.length)return;bulk.disabled=true;const response=await fetch('/host/api/photos/bulk',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'approve',ids})});if(response.ok)await load();else say('Selected photos could not be approved.')});void load();
</script>
<style>
  .host-photos{margin-top:3rem;padding-top:2rem;border-top:2px solid var(--color-ink)}.host-photos>header{display:flex;align-items:end;justify-content:space-between;gap:1rem}.host-photos h2{margin:0;font:700 clamp(2.2rem,7vw,4rem)/1 var(--font-display);text-transform:none}.host-photos button{min-height:44px;padding:.55rem .8rem;border:1px solid currentColor;background:transparent;color:inherit;font-weight:700;cursor:pointer}.host-photos button:disabled{opacity:.5}.host-photo-controls{display:flex;flex-wrap:wrap;gap:1rem;margin:1.5rem 0}.host-photo-controls label{display:grid;gap:.3rem;font-weight:700}.host-photo-controls select{min-height:44px}.host-photo-grid{display:grid;gap:1rem}.host-photo-card{padding:1rem;border:var(--border);background:rgba(255,255,255,.3)}.host-photo-card img{width:100%;aspect-ratio:4/3;object-fit:cover}.host-photo-card p{overflow-wrap:anywhere}.host-photo-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem}@media(min-width:48rem){.host-photo-grid{grid-template-columns:repeat(3,1fr)}}
</style>
