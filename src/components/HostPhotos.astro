---
import { events, type InvitationEvent } from '../data/events';
const { event } = Astro.props as { event?: InvitationEvent };
---
<section class="host-photos" data-host-photos data-initial-event={event?.slug ?? 'all'}>
  <header><div><p class="host-eyebrow">Private moderation</p><h2>Waiting for review</h2></div><div class="photo-header-actions"><button type="button" data-status-button="pending" aria-pressed="true">Pending review</button><button type="button" data-status-button="approved" aria-pressed="false">Approved</button><button type="button" data-bulk disabled>Approve all</button></div></header>
  <div class="host-photo-controls" class:list={{'host-photo-controls--single':Boolean(event)}}><label>Event<select data-photo-event disabled={Boolean(event)}><option value="all">All events</option>{events.map(item=><option value={item.slug} selected={event?.slug===item.slug}>{item.title}</option>)}</select></label><label class="visually-hidden">Status<select data-photo-status><option value="pending">Pending review</option><option value="approved">Approved</option><option value="removed">Removed</option><option value="all">All photos</option></select></label></div>
  <p data-photo-message role="status" aria-live="polite">Loading photos…</p><div class="host-photo-grid" data-photo-grid></div>
</section>
<script>
  const root=document.querySelector<HTMLElement>('[data-host-photos]');const grid=root?.querySelector<HTMLElement>('[data-photo-grid]');const message=root?.querySelector<HTMLElement>('[data-photo-message]');const eventSelect=root?.querySelector<HTMLSelectElement>('[data-photo-event]');const statusSelect=root?.querySelector<HTMLSelectElement>('[data-photo-status]');const bulk=root?.querySelector<HTMLButtonElement>('[data-bulk]');
  const say=(text:string)=>{if(message)message.textContent=text};const selected=()=>Array.from(root?.querySelectorAll<HTMLInputElement>('input[data-photo-select]:checked')||[]).map(input=>input.value);
  async function action(id:string,action:string){const response=await fetch(`/host/api/photos/${id}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({action})});if(!response.ok)throw new Error('The photo could not be updated.');await load()}
  function photoCard(photo:any){const card=document.createElement('article');card.className='host-photo-card';const img=document.createElement('img');img.src=photo.previewUrl;img.alt='Guest-submitted event photo';img.loading='lazy';const filename=document.createElement('h3');filename.textContent=photo.original_filename||'Guest upload';const meta=document.createElement('p');meta.textContent=new Intl.DateTimeFormat(undefined,{dateStyle:'medium',timeStyle:'short'}).format(new Date(photo.uploaded_at));const actions=document.createElement('div');actions.className='host-photo-actions';if(photo.moderation_status==='pending'){const select=document.createElement('input');select.type='checkbox';select.value=photo.id;select.dataset.photoSelect='';select.setAttribute('aria-label',`Select ${filename.textContent}`);select.addEventListener('change',()=>{if(bulk)bulk.disabled=!selected().length});card.append(select)}const choices=photo.moderation_status==='pending'?[['approve','Approve'],['remove','Remove']]:photo.moderation_status==='approved'?[['remove','Remove']]:[['restore','Restore']];for(const [name,label] of choices){const button=document.createElement('button');button.type='button';button.textContent=label;button.className=name==='approve'?'host-button host-button--green':'host-button host-button--danger';button.addEventListener('click',()=>action(photo.id,name).catch(error=>say(error.message)));actions.append(button)}if(photo.moderation_status==='removed'){const del=document.createElement('button');del.type='button';del.textContent='Delete permanently';del.className='host-button host-button--danger';del.addEventListener('click',async()=>{if(!confirm('Permanently delete this photo? This cannot be undone.'))return;const response=await fetch(`/host/api/photos/${photo.id}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({confirm:'DELETE'})});if(response.ok)await load();else say('The photo could not be deleted.')});actions.append(del)}card.append(img,filename,meta,actions);return card}
  async function load(){say('Loading photos…');const response=await fetch(`/host/api/photos?event=${eventSelect?.value||root?.dataset.initialEvent||'all'}&status=${statusSelect?.value||'pending'}`);const data=await response.json().catch(()=>null);if(!response.ok||!data?.ok){say(data?.message||'Photos could not be loaded.');return}grid?.replaceChildren();for(const photo of data.photos)grid?.append(photoCard(photo));say(data.photos.length?`${data.photos.length} photo${data.photos.length===1?'':'s'} shown.`:'No photos match this filter.');if(bulk)bulk.disabled=statusSelect?.value!=='pending'||!data.photos.length;root?.querySelectorAll<HTMLButtonElement>('[data-status-button]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.statusButton===statusSelect?.value)))}
  root?.querySelectorAll<HTMLButtonElement>('[data-status-button]').forEach(button=>button.addEventListener('click',()=>{if(statusSelect)statusSelect.value=button.dataset.statusButton||'pending';void load()}));eventSelect?.addEventListener('change',load);bulk?.addEventListener('click',async()=>{let ids=selected();if(!ids.length)ids=Array.from(root?.querySelectorAll<HTMLElement>('.host-photo-card input[data-photo-select]')||[]).map(input=>(input as HTMLInputElement).value);if(!ids.length)return;bulk.disabled=true;const response=await fetch('/host/api/photos/bulk',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'approve',ids})});if(response.ok)await load();else say('Selected photos could not be approved.')});void load();
</script>
<style>
  .host-photos{padding-top:1.5rem}.host-photos>header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:1px solid var(--host-ink)}.host-photos h2{margin:.6rem 0 0;color:var(--host-gold);font:400 clamp(2.1rem,4vw,3rem)/1 var(--host-display)}.photo-header-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.5rem}.photo-header-actions button{min-height:44px;padding:.65rem 1rem;border:1px solid var(--host-rule);background:transparent;color:var(--host-ink);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase}.photo-header-actions button[aria-pressed='true']{border-color:var(--host-ink);background:var(--host-ink);color:white}.photo-header-actions [data-bulk]{border-color:var(--host-green);color:var(--host-green)}.host-photo-controls{margin:1rem 0}.host-photo-controls--single{display:none}.host-photo-controls label{display:grid;max-width:20rem;gap:.35rem}.host-photo-controls select{min-height:44px}.host-photo-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem 1.5rem;margin-top:1.5rem}.host-photo-card{position:relative}.host-photo-card>input{position:absolute;top:.75rem;left:.75rem;width:1.3rem;height:1.3rem;z-index:1}.host-photo-card img{width:100%;aspect-ratio:4/3;border:1px solid var(--host-rule);object-fit:cover}.host-photo-card h3{margin:.65rem 0 .15rem;font:400 1.1rem/1.2 var(--host-body)}.host-photo-card p{margin:0 0 .7rem;font-size:.65rem;letter-spacing:.12em;text-transform:uppercase}.host-photo-actions{display:grid;grid-template-columns:1fr auto;gap:.6rem}.host-photo-actions .host-button{width:100%}@media(max-width:42rem){.host-photos>header{align-items:flex-start;flex-direction:column}.photo-header-actions{justify-content:flex-start}.host-photo-grid{grid-template-columns:1fr}}
</style>
