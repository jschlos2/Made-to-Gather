---
const statusLabels: Record<string, string> = { draft:'Draft', rsvp_open:'RSVP open', rsvp_closed:'RSVP closed', event_day:'Event day', photos_open:'Photos open', archived:'Archived' };
---
<section class="host-events" data-host-events data-status-labels={JSON.stringify(statusLabels)}>
  <header><div><p class="host-kicker">Family archive</p><h2>Events</h2></div><a href="/host/archive/">Open archive</a></header>
  <p data-events-status role="status" aria-live="polite">Loading events…</p>
  <div class="host-event-list" data-event-list></div>
</section>
<script>
  const root=document.querySelector<HTMLElement>('[data-host-events]');const list=root?.querySelector<HTMLElement>('[data-event-list]');const status=root?.querySelector<HTMLElement>('[data-events-status]');const labels=JSON.parse(root?.dataset.statusLabels||'{}');
  const link=(text:string,href:string)=>{const a=document.createElement('a');a.textContent=text;a.href=href;return a};
  async function loadEvents(){const response=await fetch('/host/api/events');const data=await response.json().catch(()=>null);if(!response.ok||!data?.ok){if(status)status.textContent=data?.message||'Events could not be loaded.';return}list?.replaceChildren();for(const event of data.events){const article=document.createElement('article');article.className='host-event-row';const heading=document.createElement('h3');heading.textContent=event.title;const meta=document.createElement('p');meta.textContent=`${event.date} · ${labels[event.status]||event.status} · ${event.timeZone}`;const counts=document.createElement('p');counts.textContent=`${event.rsvpCount} RSVPs · ${event.approvedPhotoCount} approved photos · ${event.pendingPhotoCount} pending`;const actions=document.createElement('div');actions.className='host-event-actions';const settings=`/host/events/${event.slug}/edit/`;actions.append(link('View event',event.status==='draft'?`/host/events/${event.slug}/preview/`:`/events/${event.slug}/`),link('Edit event configuration',settings),link('Change status',settings),link('Open guest list',`/host/?event=${event.slug}`),link('Open photo moderation',`/host/?photoEvent=${event.slug}#photo-moderation`));article.append(heading,meta,counts,actions);list?.append(article)}if(status)status.textContent=`${data.events.length} family event${data.events.length===1?'':'s'}.`}
  void loadEvents();
</script>
<style>
  .host-events{margin-bottom:3rem;padding-bottom:2rem;border-bottom:2px solid var(--color-ink)}.host-events>header{display:flex;align-items:end;justify-content:space-between;gap:1rem}.host-events h2{margin:0;font:700 clamp(2.2rem,7vw,4rem)/1 var(--font-display);text-transform:none}.host-event-list{display:grid;gap:.75rem}.host-event-row{padding:1rem;border:var(--border);background:rgba(255,255,255,.28)}.host-event-row h3{margin:0 0 .35rem}.host-event-row p{margin:.2rem 0}.host-event-actions{display:flex;flex-wrap:wrap;gap:.5rem 1rem;margin-top:.8rem}.host-event-actions a{font-weight:700}@media(min-width:60rem){.host-event-row{display:grid;grid-template-columns:1.2fr 1fr 1fr;align-items:center;gap:1rem}.host-event-actions{grid-column:1/-1}}
</style>
