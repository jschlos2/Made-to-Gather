---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HostShell from '../../../../components/HostShell.astro';
import HostGuests from '../../../../components/HostGuests.astro';
import { events, type InvitationEvent } from '../../../../data/events';
export const getStaticPaths = (() => events.map(event => ({ params:{slug:event.slug}, props:{event} }))) satisfies GetStaticPaths;
const { event } = Astro.props as { event: InvitationEvent };
---
<BaseLayout title={`Guests · ${event.title}`} description="Private event guest list" robots="noindex, nofollow, noarchive" themeClass="host-page"><HostShell event={event} active="guests" sectionNumber="3" sectionLabel="Guests"><HostGuests event={event}/></HostShell></BaseLayout>
