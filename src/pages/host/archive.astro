---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Made to Gather family archive" description="Private family gathering archive" robots="noindex, nofollow, noarchive" themeClass="host-page">
  <main class="archive" data-archive>
    <header><p class="host-kicker">Made to Gather</p><h1>Family archive</h1><p>A private home for upcoming invitations and memories from gatherings past.</p><a href="/host/">RSVP and photo dashboard</a></header>
    <p data-archive-status role="status" aria-live="polite">Loading family events…</p>
    <section aria-labelledby="drafts-title"><h2 id="drafts-title">Drafts</h2><div class="archive-grid" data-group="drafts"></div></section>
    <section aria-labelledby="upcoming-title"><h2 id="upcoming-title">Upcoming Gatherings</h2><div class="archive-grid" data-group="upcoming"></div></section>
    <section aria-labelledby="past-title"><h2 id="past-title">Past Gatherings</h2><div class="archive-grid" data-group="past"></div></section>
  </main>
</BaseLayout>
<script>
  const root=document.querySelector<HTMLElement>('[data-archive]');const message=root?.querySelector<HTMLElement>('[data-archive-status]');const groups={drafts:root?.querySelector<HTMLElement>('[data-group=drafts]'),upcoming:root?.querySelector<HTMLElement>('[data-group=upcoming]'),past:root?.querySelector<HTMLElement>('[data-group=past]')};const labels:Record<string,string>={draft:'Draft',rsvp_open:'RSVP open',rsvp_closed:'RSVP closed',event_day:'Event day',photos_open:'Photos open',archived:'Archived'};
  const category=(status:string)=>status==='draft'?'drafts':status==='archived'||status==='photos_open'?'past':'upcoming';
  fetch('/host/api/events').then(async response=>{const data=await response.json().catch(()=>null);if(!response.ok||!data?.ok)throw new Error(data?.message);for(const event of data.events){const card=document.createElement('article');card.className='archive-card';const img=document.createElement('img');img.src=event.artwork.src;img.alt=event.artwork.alt;img.width=event.artwork.width;img.height=event.artwork.height;img.loading='lazy';const copy=document.createElement('div');const heading=document.createElement('h3');heading.textContent=event.title;const meta=document.createElement('p');meta.textContent=`${event.date} · ${labels[event.status]}`;const view=document.createElement('a');view.href=event.status==='draft'?`/host/events/${event.slug}/preview/`:`/events/${event.slug}/`;view.textContent=event.status==='draft'?'Preview draft':'View gathering';const edit=document.createElement('a');edit.href=`/host/events/${event.slug}/edit/`;edit.textContent='Manage';copy.append(heading,meta,view,document.createTextNode(' · '),edit);card.append(img,copy);groups[category(event.status)]?.append(card)}for(const [name,group] of Object.entries(groups)){if(group&&!group.children.length){const empty=document.createElement('p');empty.className='archive-empty';empty.textContent=name==='drafts'?'No draft invitations.':name==='past'?'No past gatherings yet.':'No upcoming gatherings.';group.append(empty)}}if(message)message.textContent=`${data.events.length} family event${data.events.length===1?'':'s'} in the archive.`}).catch(()=>{if(message)message.textContent='The family archive could not be loaded.'});
</script>
<style>
  .archive{width:min(76rem,100%);min-height:100vh;margin:auto;padding:clamp(2rem,6vw,5rem) 1.25rem}.archive>header{padding-bottom:2rem;border-bottom:2px solid var(--color-ink)}.archive h1{max-width:none;margin:.4rem 0 1rem;font:700 clamp(3rem,10vw,6rem)/.95 var(--font-display);text-transform:none}.archive section{padding:2rem 0;border-bottom:var(--border)}.archive h2{margin-bottom:1rem;font:700 clamp(1.7rem,4vw,2.6rem)/1 var(--font-display);text-transform:none}.archive-grid{display:grid;gap:1rem}.archive-card{display:grid;grid-template-columns:7rem 1fr;gap:1rem;align-items:center;padding:.75rem;border:var(--border);background:rgba(255,255,255,.3)}.archive-card img{width:7rem;height:6rem;object-fit:cover}.archive-card h3{margin:0 0 .35rem}.archive-card p{margin:0 0 .5rem}.archive-card a{font-weight:700}.archive-empty{margin:0;font-style:italic}@media(min-width:48rem){.archive-grid{grid-template-columns:repeat(2,1fr)}}
</style>
