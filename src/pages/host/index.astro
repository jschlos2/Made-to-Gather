---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HostShell from '../../components/HostShell.astro';
---
<BaseLayout title="Made to Gather host dashboard" description="Private family event dashboard" robots="noindex, nofollow, noarchive" themeClass="host-page">
  <HostShell>
    <p class="host-page-id">1 — Global Dashboard</p>
    <p class="dashboard-status" data-dashboard-status role="status" aria-live="polite">Loading dashboard…</p>
    <dl class="dashboard-metrics" aria-label="Dashboard totals">
      <div><dt>RSVPs received</dt><dd data-metric="rsvps">—</dd><p>Across your gatherings</p></div>
      <div><dt>Attendees expected</dt><dd data-metric="attendees">—</dd><p data-attendee-note>Adults and children</p></div>
      <div class="dashboard-metric--attention"><dt>Photos awaiting review</dt><dd data-metric="photos">—</dd><p><a href="/host/events/graduation/photos/">Review uploads</a></p></div>
      <div><dt>Dietary notes flagged</dt><dd data-metric="dietary">—</dd><p>Worth a glance before menus</p></div>
    </dl>
    <section aria-labelledby="upcoming-title"><div class="host-section-title"><h2 id="upcoming-title">Upcoming events</h2><small data-upcoming-count>—</small></div><div class="dashboard-event-list" data-event-group="upcoming"></div></section>
    <section aria-labelledby="past-title"><div class="host-section-title"><h2 id="past-title">Past gatherings</h2><a class="dashboard-archive-link" href="/host/archive/">Open archive</a></div><div class="dashboard-event-list dashboard-event-list--past" data-event-group="past"></div></section>
  </HostShell>
</BaseLayout>
<script>
  const labels:Record<string,string>={draft:'Draft',rsvp_open:'RSVP open',rsvp_closed:'RSVP closed',event_day:'Event day',photos_open:'Photos open',archived:'Archived'};
  const status=document.querySelector<HTMLElement>('[data-dashboard-status]');const upcomingRoot=document.querySelector<HTMLElement>('[data-event-group="upcoming"]');const pastRoot=document.querySelector<HTMLElement>('[data-event-group="past"]');
  const setMetric=(name:string,value:unknown)=>{const target=document.querySelector<HTMLElement>(`[data-metric="${name}"]`);if(target)target.textContent=String(value??0)};
  const makeLink=(label:string,href:string,className='host-button')=>{const a=document.createElement('a');a.textContent=label;a.href=href;a.className=className;return a};
  function eventRow(event:Record<string,any>,past:boolean){const article=document.createElement('article');article.className=`dashboard-event-row${past?' dashboard-event-row--past':''}`;const img=document.createElement('img');img.src=event.artwork.src;img.alt=event.artwork.alt;img.width=event.artwork.width;img.height=event.artwork.height;img.loading='lazy';const copy=document.createElement('div');copy.className='dashboard-event-copy';const titleLine=document.createElement('div');titleLine.className='dashboard-event-title';const heading=document.createElement('h3');heading.textContent=event.title;const badge=document.createElement('span');badge.className=`host-status-badge${event.status==='rsvp_open'?' host-status-badge--open':''}`;badge.textContent=labels[event.status]||event.status;titleLine.append(heading,badge);const date=document.createElement('p');date.textContent=event.date;const counts=document.createElement('p');counts.className='host-meta';counts.textContent=`${event.rsvpCount} RSVPs · ${event.attendeeCount} attendees · ${event.pendingPhotoCount?`${event.pendingPhotoCount} photos pending`:'No photos pending'}`;copy.append(titleLine,date,counts);const actions=document.createElement('div');actions.className='dashboard-event-actions';actions.append(makeLink('Open event',event.status==='draft'?`/host/events/${event.slug}/preview/`:`/host/events/${event.slug}/`),makeLink('···',`/host/events/${event.slug}/edit/`,'host-button host-button--outline dashboard-more'));article.append(img,copy,actions);return article}
  async function load(){try{const [eventsResponse,rsvpsResponse]=await Promise.all([fetch('/host/api/events'),fetch('/host/api/rsvps?event=all&attendance=all&sort=newest')]);const eventData=await eventsResponse.json();const rsvpData=await rsvpsResponse.json();if(!eventsResponse.ok||!eventData.ok||!rsvpsResponse.ok||!rsvpData.ok)throw new Error('Dashboard data could not be loaded.');setMetric('rsvps',Number(rsvpData.summary.attending||0)+Number(rsvpData.summary.declines||0));setMetric('attendees',rsvpData.summary.attendees);setMetric('dietary',rsvpData.summary.dietaryNotes);setMetric('photos',eventData.events.reduce((sum:number,event:any)=>sum+Number(event.pendingPhotoCount||0),0));const attendeeNote=document.querySelector<HTMLElement>('[data-attendee-note]');if(attendeeNote)attendeeNote.textContent=`${rsvpData.summary.adults||0} adults · ${rsvpData.summary.children||0} children`;const upcoming=eventData.events.filter((event:any)=>!['archived','photos_open'].includes(event.status));const past=eventData.events.filter((event:any)=>['archived','photos_open'].includes(event.status));const planned=document.querySelector<HTMLElement>('[data-upcoming-count]');if(planned)planned.textContent=`${upcoming.length} planned`;for(const [root,items,isPast] of [[upcomingRoot,upcoming,false],[pastRoot,past,true]] as const){root?.replaceChildren();if(!items.length){const empty=document.createElement('p');empty.className='host-empty';empty.textContent=isPast?'No past gatherings yet.':'No upcoming gatherings.';root?.append(empty)}else items.forEach((event:any)=>root?.append(eventRow(event,isPast)))}if(status){status.textContent=`${eventData.events.length} family events loaded.`;status.classList.add('visually-hidden')}}catch{if(status)status.textContent='Dashboard data could not be loaded. Refresh to try again.'}}void load();
</script>
<style>
  .dashboard-status{margin:0 0 1rem}.dashboard-metrics{display:grid;grid-template-columns:repeat(4,1fr);margin:0 0 2rem;border:1px solid var(--host-rule-soft);background:color-mix(in srgb,var(--host-parchment),transparent 66%)}.dashboard-metrics>div{min-width:0;padding:1.4rem 1.5rem 1.6rem;border-right:1px solid var(--host-rule-soft)}.dashboard-metrics>div:last-child{border-right:0}.dashboard-metrics dt{min-height:2rem;font-size:.68rem;letter-spacing:.19em;text-transform:uppercase}.dashboard-metrics dd{margin:.45rem 0 .25rem;font:700 clamp(2.8rem,5vw,4.4rem)/.9 var(--host-numeric)}.dashboard-metrics p{margin:0;font-size:.88rem}.dashboard-metric--attention dd,.dashboard-metric--attention a{color:var(--host-chestnut)}.dashboard-archive-link{margin-left:auto;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase}.dashboard-event-row{display:grid;grid-template-columns:8.5rem minmax(0,1fr) auto;align-items:center;gap:1.5rem;margin-bottom:1rem;padding:1.25rem;border:1px solid var(--host-rule-soft);background:color-mix(in srgb,var(--host-paper),transparent 8%)}.dashboard-event-row>img{width:8.5rem;height:9.4rem;border:1px solid var(--host-rule);object-fit:cover}.dashboard-event-title{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem}.dashboard-event-title h3{margin:0;color:var(--host-ink);font:400 clamp(1.7rem,3vw,2.6rem)/1 var(--host-display)}.dashboard-event-copy>p{margin:.55rem 0}.dashboard-event-actions{display:flex;gap:.75rem}.dashboard-more{min-width:44px;padding-inline:.6rem}.dashboard-event-row--past{grid-template-columns:5.25rem minmax(0,1fr) auto;padding-block:1.15rem}.dashboard-event-row--past>img{width:5.25rem;height:5.25rem}.dashboard-event-row--past .dashboard-event-title h3{font-size:1.55rem}.dashboard-event-row--past .host-status-badge{display:none}@media(max-width:60rem){.dashboard-metrics{grid-template-columns:repeat(2,1fr)}.dashboard-metrics>div:nth-child(2){border-right:0}.dashboard-event-row{grid-template-columns:6.5rem minmax(0,1fr)}.dashboard-event-row>img{width:6.5rem;height:7.5rem}.dashboard-event-actions{grid-column:2}}@media(max-width:36rem){.dashboard-metrics>div{padding:1rem .75rem}.dashboard-metrics dd{font-size:2.5rem}.dashboard-event-row,.dashboard-event-row--past{grid-template-columns:5rem minmax(0,1fr);gap:1rem;padding:1rem}.dashboard-event-row>img,.dashboard-event-row--past>img{width:5rem;height:6rem}.dashboard-event-actions{grid-column:1/-1}.dashboard-event-actions .host-button:first-child{flex:1}}
</style>
