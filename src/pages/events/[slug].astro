---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InvitationPage from '../../components/InvitationPage.astro';
import { events, getThemeClasses, getThemeStyle, type InvitationEvent } from '../../data/events';

export const getStaticPaths = (() => events.filter((event) => event.lifecycle.status !== 'draft').map((event) => ({
  params: { slug: event.slug },
  props: { event },
}))) satisfies GetStaticPaths;

interface Props { event: InvitationEvent }
const { event } = Astro.props;
const themeClass = getThemeClasses(event.theme);
---

<BaseLayout
  title={event.title}
  description={`${event.subtitle}. ${event.date.weekday}, ${event.date.monthDay}, ${event.date.year}.`}
  themeColor={event.theme.colors.paper}
  themeStyle={getThemeStyle(event.theme)}
  themeClass={themeClass}
  robots="noindex, nofollow, noarchive"
  referrer="strict-origin-when-cross-origin"
  socialImage={event.artwork.src}
  socialImageAlt={event.artwork.alt}
  socialImageWidth={event.artwork.width}
  socialImageHeight={event.artwork.height}
>
  <InvitationPage event={event} />
</BaseLayout>
