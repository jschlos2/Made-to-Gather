---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Invitation not found" description="The requested invitation could not be found." robots="noindex, nofollow, noarchive">
  <main class="not-found">
    <p class="section-kicker">404 · Invitation not found</p>
    <h1>This gathering isn’t on the list.</h1>
    <p>The invitation link may be incorrect, or the event may no longer be available.</p>
    <a href="/">Return to Made to Gather</a>
  </main>
</BaseLayout>
